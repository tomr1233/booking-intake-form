# Domain Caddy serves on (e.g. clarity.example.com).
# Caddy automatically provisions and renews HTTPS for this domain.
DOMAIN=your-domain.com

# API base URL baked into the frontend at build time.
# Leave EMPTY for a same-domain deploy: the app calls /api/* on the same origin
# and Caddy proxies those requests to the backend stack. Only set a full URL
# (e.g. https://api.your-domain.com) if the API runs on a DIFFERENT domain, in
# which case the backend must allow that origin via CORS.
VITE_API_URL=
