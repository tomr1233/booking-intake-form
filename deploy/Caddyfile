# REFERENCE ONLY — this is NOT loaded by this docker stack.
#
# intake.expressnext.app is served by the Caddy running as a HOST process on
# the VPS. Put the block below into that host Caddy config (e.g.
# /etc/caddy/Caddyfile), then reload it:  sudo systemctl reload caddy
#
# It splits the same domain: /api/* and /health go to the backend
# (intake-form-api, published on 127.0.0.1:8080); everything else goes to the
# frontend container (published on 127.0.0.1:3000). Same-origin, so no CORS.

intake.expressnext.app {
    # API + health check -> backend (intake-form-api)
    handle /api/* {
        reverse_proxy 127.0.0.1:8080
    }
    handle /health {
        reverse_proxy 127.0.0.1:8080
    }

    # Everything else -> frontend (Clarity SPA)
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
